# table-qa configuration. Copy to .env and edit.
# Placeholder values only. Never commit real keys.

# Choose a backend: "api" (any OpenAI-compatible endpoint) or "hf" (open models via transformers)
MS_BACKEND=hf

# --- (a) api: bring your own key, any OpenAI-compatible endpoint ---
MS_API_BASE=https://your-provider.example/v1
MS_API_KEY=your-api-key
MS_MODEL=your-chat-model
# Optional: a second model on the same endpoint for the plain-language sentence.
# When empty, MS_MODEL writes the code and the sentence.
MS_ANSWER_MODEL=

# --- (b) hf: open-source models from Hugging Face, run locally with transformers ---
# The 7B models need a GPU or a lot of memory. On a CPU-only machine set MS_SMALL=1
# (Qwen2.5-Coder-1.5B-Instruct for the code, Qwen2.5-1.5B-Instruct for the sentence).
# On CPU the two models are loaded one at a time.
MS_SMALL=0
MS_HF_CODE_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
MS_HF_ANSWER_MODEL=Qwen/Qwen2.5-7B-Instruct
# HF_TOKEN=your-hf-token   # only needed for gated models; these defaults are public

# --- shared ---
# Seconds the sandbox is allowed to run the generated code.
MS_SANDBOX_TIMEOUT=30
# Tokens for the code reply. The sentence uses a shorter cap.
MS_MAX_NEW_TOKENS=512
# Where the web demo keeps saved results.
MS_CACHE_DIR=.cache/results
